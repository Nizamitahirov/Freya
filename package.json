{
  "name": "compensation-planning-tool",
  "version": "0.1.0",
  "private": true,
  "description": "Compensation Planning Tool — net→gross→supergross engine, budget control, multi-stage HR review workflow (see Compensation-Planning-Tool-SRS.md)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx -r tsconfig-paths/register scripts/seed.ts",
    "rules:deploy": "node scripts/deploy-rules.mjs",
    "auth:setup": "node scripts/auth-setup.mjs",
    "grant": "tsx -r tsconfig-paths/register scripts/grant.ts",
    "smoke": "node --conditions=react-server --import tsx -r tsconfig-paths/register scripts/smoke.ts",
    "rules:test": "node --conditions=react-server --import tsx -r tsconfig-paths/register scripts/rules-test.ts",
    "e2e": "node --conditions=react-server --import tsx -r tsconfig-paths/register scripts/e2e.ts",
    "auth:domain": "node scripts/auth-domain.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.10.0",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "next": "15.5.25",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "^2.15.4",
    "server-only": "^0.0.1",
    "zod": "3.24.1",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "dotenv": "^17.4.2",
    "playwright-core": "^1.49.0",
    "tailwindcss": "^4.3.3",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.13",
    "typescript": "5.7.3",
    "vitest": "3.2.7"
  }
}
