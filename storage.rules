rules_version = '2';

// Market data (CSV/XLSX) yüklənməsi (SRS §12) — şirkət-izolyasiyalı.
service firebase.storage {
  match /b/{bucket}/o {
    match /companies/{companyId}/market/{fileName} {
      allow read: if request.auth != null;
      // Yükləmə yalnız autentifikasiya olunmuş istifadəçilərə; rol yoxlaması
      // server (Admin SDK) tərəfində parse mərhələsində aparılır.
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('text/.*|application/.*sheet.*|application/vnd.ms-excel');
    }
  }
}
